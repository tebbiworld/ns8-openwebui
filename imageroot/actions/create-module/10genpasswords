# Generate WEBUI_SECRET_KEY (session/JWT signing key) into state/passwords.env
# (mode 0600): it must not be stored in state/environment, which NS8 mirrors to
# Redis in plain text.

import secrets

import modsecrets

modsecrets.ensure({"WEBUI_SECRET_KEY": secrets.token_hex(32)})
