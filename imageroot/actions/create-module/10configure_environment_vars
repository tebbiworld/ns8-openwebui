# Seed the environment for a fresh Open WebUI instance: reserve the TCP port that
# Traefik reverse-proxies to, and generate a stable session signing key. The rest
# (host name, external Ollama URL, LDAP/AD settings) is applied by
# configure-module.

import os
import secrets

import agent

# The node allocates org.nethserver.tcp-ports-demand ports as a comma-separated
# TCP_PORTS list. Reserve a single port, published on 127.0.0.1 and fronted by
# Traefik.
tcp_ports = [p.strip() for p in os.environ.get("TCP_PORTS", "").split(",") if p.strip()]
web_port = tcp_ports[0] if tcp_ports else "8080"
agent.set_env("WEB_PORT", web_port)

# JWT signing key for Open WebUI sessions. Generated once and kept stable so
# existing sessions survive restarts and container recreation.
agent.set_env("WEBUI_SECRET_KEY", secrets.token_hex(32))

agent.dump_env()
