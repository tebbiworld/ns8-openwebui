# Apply the Open WebUI module configuration.
#
# Two kinds of settings are written:
#   * agent.set_env(...) -> state/environment: readable settings echoed back by
#     get-configuration, plus values the systemd unit expands (WEB_PORT,
#     OPEN_WEBUI_IMAGE, TRAEFIK_*).
#   * state/openwebui.env -> passed to the container with --env-file. The
#     application settings (Ollama URL, sign-up, ...) reach Open WebUI there.
#
# The directory login is handled by the shared pypkg/ldapsettings.py (identical
# to ns8-clamav / ns8-idevice-backup) plus the module glue in pypkg/owldap.py.
# Its native LDAP_* settings are NOT written here: bin/discover-ldap resolves
# them into state/ldap.env on every start, so a rotated bind password or a
# moved user domain is picked up without re-saving this page.

import os
import sys
import json

import agent
import ldapsettings
import modsecrets


def as_bool_str(value, default=False):
    if isinstance(value, str):
        value = value.strip().lower() in ("1", "true", "yes", "on")
    return "true" if bool(value) else "false"


data = json.load(sys.stdin)

# --- Traefik transport -------------------------------------------------------
host = data["host"]
h2hs = data.get("http2https", True)
lets_encrypt = data.get("lets_encrypt", False)
agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", h2hs)
if "lets_encrypt" in data:
    # kept so restore-module can re-create the route with the same setting
    agent.set_env("TRAEFIK_LETS_ENCRYPT", data["lets_encrypt"])

scheme = "https" if (lets_encrypt or h2hs) else "http"
webui_url = f"{scheme}://{host}"

# --- Application settings ----------------------------------------------------
# External Ollama instance (this module does not bundle Ollama). One or more
# base URLs, e.g. http://10.0.0.5:11434 (separate several with ';').
ollama_base_url = (data.get("ollama_base_url") or "").strip().rstrip("/")
webui_name = data.get("webui_name") or "Open WebUI"
enable_signup = as_bool_str(data.get("enable_signup", False), False)
enable_openai_api = as_bool_str(data.get("enable_openai_api", False), False)
default_user_role = data.get("default_user_role") or "pending"
timezone = data.get("timezone") or "UTC"

agent.set_env("OLLAMA_BASE_URL", ollama_base_url)
agent.set_env("WEBUI_NAME", webui_name)
agent.set_env("WEBUI_URL", webui_url)
agent.set_env("ENABLE_SIGNUP", enable_signup)
agent.set_env("ENABLE_OPENAI_API", enable_openai_api)
agent.set_env("DEFAULT_USER_ROLE", default_user_role)
agent.set_env("TZ", timezone)

# --- Knowledge base (RAG) base values ----------------------------------------
# Optional seed-once defaults for Open WebUI's retrieval settings (embedding
# engine/model, Top K, chunking). They are written to the env file only as a
# seed: with ENABLE_PERSISTENT_CONFIG=true Open WebUI copies a key from the
# environment into its database only while the key is still missing, and the
# database wins from then on. These keys are deliberately NOT reset by
# bin/enforce-module-settings, so a value set here configures a FRESH instance
# and never silently overrides what an existing instance already has. That
# matters above all for the embedding engine/model: changing it on an instance
# that already holds documents makes the indexed knowledge bases unsearchable
# (a different vector dimension), so that change has to be made in the Open
# WebUI admin panel together with a re-index, not from here.


def opt_str(value):
    return (value or "").strip()


def opt_int(value, field, minimum):
    """An optional non-negative integer field: '' when unset, else validated."""
    if value is None or value == "":
        return ""
    try:
        number = int(value)
    except (TypeError, ValueError):
        number = None
    if number is None or number < minimum:
        agent.set_status("validation-failed")
        json.dump(
            [{"field": field, "parameter": field, "value": value, "error": "invalid_number"}],
            fp=sys.stdout,
        )
        sys.exit(2)
    return str(number)


rag_embedding_engine = opt_str(data.get("rag_embedding_engine"))
rag_embedding_model = opt_str(data.get("rag_embedding_model"))
rag_top_k = opt_int(data.get("rag_top_k"), "rag_top_k", 1)
rag_chunk_size = opt_int(data.get("rag_chunk_size"), "rag_chunk_size", 1)
rag_chunk_overlap = opt_int(data.get("rag_chunk_overlap"), "rag_chunk_overlap", 0)

# Echoed back by get-configuration (the configured seed, not the live database
# value, which the admin panel may have changed).
agent.set_env("RAG_EMBEDDING_ENGINE", rag_embedding_engine)
agent.set_env("RAG_EMBEDDING_MODEL", rag_embedding_model)
agent.set_env("RAG_TOP_K", rag_top_k)
agent.set_env("CHUNK_SIZE", rag_chunk_size)
agent.set_env("CHUNK_OVERLAP", rag_chunk_overlap)

# --- Directory login (shared building block) ---------------------------------
# domain  = a user domain of this cluster (ldapproxy, no credentials stored)
# custom  = an LDAP server of its own (URL/bind DN in the environment, bind
#           password in state/passwords.env)
ldap_enabled = bool(data.get("ldap_enabled", False))
agent.set_env("LDAP_ENABLED", "true" if ldap_enabled else "false")
ldapsettings.apply(data, active=ldap_enabled, legacy_source="custom")

# Open WebUI needs a login button label and a mail attribute (it refuses users
# without an e-mail); these are not part of the shared settings.
agent.set_env("LDAP_LABEL", (data.get("ldap_label") or "AD / LDAP").strip() or "AD / LDAP")
agent.set_env("LDAP_MAIL_ATTRIBUTE", (data.get("ldap_mail_attribute") or "mail").strip() or "mail")

# The settings page is authoritative for the search filter through ldap_group;
# drop the migration escape hatch (a free-text filter preserved from an older
# version) once the page has been saved.
if os.environ.get("LDAP_RAW_SEARCH_FILTER"):
    agent.munset_env(["LDAP_RAW_SEARCH_FILTER"])

# --- Container env file (--env-file) -----------------------------------------
# Everything the Open WebUI container consumes at runtime, except the native
# LDAP_* settings (state/ldap.env, written by bin/discover-ldap). Written
# atomically; carries WEBUI_SECRET_KEY, so keep it private.
lines = [
    "# Generated by configure-module. Do not edit by hand.",
    # Open WebUI stores its settings in the database: env values only seed keys
    # that are missing, afterwards the database wins. Keep that enabled so the
    # changes made in the Open WebUI admin panel (embedding model, chunk size,
    # default model parameters, ...) survive a restart. The settings owned by
    # this module (Ollama URL, sign-up, user role, LDAP) are reset to the values
    # below / in ldap.env before every start by bin/enforce-module-settings.
    "ENABLE_PERSISTENT_CONFIG=true",
    # Seed only (the admin panel can change it): local models of 14B parameters
    # and below cannot drive Open WebUI's native tool calling reliably (invented
    # tool calls, garbage tokens); the legacy mode injects the knowledge-base
    # results into the prompt instead.
    'DEFAULT_MODEL_PARAMS={"function_calling":"legacy"}',
    # Seed only: allow users to mint personal API keys (ENABLE_API_KEYS, off by
    # default upstream). Needed for programmatic access such as the automated
    # document upload into the knowledge base. Treat the keys as credentials; an
    # administrator can turn this off again in the admin panel.
    "ENABLE_API_KEYS=true",
    # The container runs with --network=host (see openwebui.service); bind the
    # web server to the loopback port allocated by the node only.
    "HOST=127.0.0.1",
    f"PORT={os.environ['WEB_PORT']}",
    f"WEBUI_SECRET_KEY={modsecrets.get('WEBUI_SECRET_KEY')}",
    f"WEBUI_URL={webui_url}",
    f"WEBUI_NAME={webui_name}",
    f"OLLAMA_BASE_URL={ollama_base_url}",
    f"ENABLE_SIGNUP={enable_signup}",
    f"ENABLE_OPENAI_API={enable_openai_api}",
    f"DEFAULT_USER_ROLE={default_user_role}",
    f"TZ={timezone}",
]
# RAG base values: appended only when set, as seed-once values (see above). When
# all are left empty the file is byte-for-byte what earlier versions produced.
for seed_key, seed_value in (
    ("RAG_EMBEDDING_ENGINE", rag_embedding_engine),
    ("RAG_EMBEDDING_MODEL", rag_embedding_model),
    ("RAG_TOP_K", rag_top_k),
    ("CHUNK_SIZE", rag_chunk_size),
    ("CHUNK_OVERLAP", rag_chunk_overlap),
):
    if seed_value != "":
        lines.append(f"{seed_key}={seed_value}")
os.umask(0o077)
with open("openwebui.env.tmp", "w") as fp:
    fp.write("\n".join(lines) + "\n")
os.replace("openwebui.env.tmp", "openwebui.env")
