# Enable and (re)start the Open WebUI pod. Restarting the pod unit cascades to
# the Ollama and Open WebUI containers through the unit dependencies.

import subprocess

units = ["openwebui.service", "openwebui-ollama.service", "openwebui-app.service"]
subprocess.run(["systemctl", "--user", "enable", *units], check=True)
subprocess.run(["systemctl", "--user", "restart", "openwebui.service"], check=True)
