# Enable and (re)start the Open WebUI service so the new configuration and
# env-file take effect.

import subprocess

subprocess.run(["systemctl", "--user", "enable", "openwebui.service"], check=True)
subprocess.run(["systemctl", "--user", "restart", "openwebui.service"], check=True)
