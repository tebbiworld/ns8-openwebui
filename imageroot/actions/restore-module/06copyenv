# Copy the non-secret settings of the original instance. Secrets come back with
# the restored state/passwords.env; a backup taken with an older module version
# still carries them in the environment, so they are moved to the file here.
# WEBUI_SECRET_KEY must be the original one: sessions and stored API keys
# depend on it.

import json
import sys

import agent
import modsecrets

request = json.load(sys.stdin)
if "environment" in request:
    # restore-module: the environment of the backup comes with the request
    env = request["environment"]
else:
    # clone-module (this file is linked there as 20copyenv): the core imports only
    # the variables the new instance does not have yet, so everything preset by
    # create-module would keep its default. The core leaves the source instance's
    # environment in state/environment.clone-module until its last step.
    env = agent.read_envfile("environment.clone-module")

KEEP = ["TRAEFIK_HOST", "TRAEFIK_HTTP2HTTPS", "TRAEFIK_LETS_ENCRYPT", "OLLAMA_BASE_URL", "WEBUI_NAME",
        "WEBUI_URL", "ENABLE_SIGNUP", "ENABLE_OPENAI_API", "DEFAULT_USER_ROLE", "TZ",
        "LDAP_ENABLED", "LDAP_LABEL", "LDAP_URL", "LDAP_BASE_DN", "LDAP_BIND_DN", "LDAP_USER_ATTRIBUTE",
        "LDAP_MAIL_ATTRIBUTE", "LDAP_SEARCH_FILTER", "LDAP_VALIDATE_CERT"]
SECRETS = ["WEBUI_SECRET_KEY", "LDAP_BIND_PASSWORD"]

agent.mset_env({k: env[k] for k in KEEP if k in env})

legacy = {k: env[k] for k in SECRETS if env.get(k)}
if legacy:
    modsecrets.write(legacy)
    print("restored legacy secrets from the backup environment into passwords.env", file=sys.stderr)
