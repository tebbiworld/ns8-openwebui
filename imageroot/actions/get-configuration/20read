# Return the current configuration for the UI. The LDAP bind password is never
# echoed back; only a boolean tells the UI whether one is stored.

import os
import sys
import json

import agent
import modsecrets

host = os.getenv("TRAEFIK_HOST", "")

config = {
    "host": host,
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS") == "True",
    "lets_encrypt": agent.get_route(os.environ["MODULE_ID"]).get("lets_encrypt", False),
    "webui_name": os.getenv("WEBUI_NAME", "Open WebUI"),
    "ollama_base_url": os.getenv("OLLAMA_BASE_URL", ""),
    "enable_signup": os.getenv("ENABLE_SIGNUP", "true") == "true",
    "default_user_role": os.getenv("DEFAULT_USER_ROLE", "pending"),
    "enable_openai_api": os.getenv("ENABLE_OPENAI_API", "false") == "true",
    "timezone": os.getenv("TZ", "UTC"),
    "ldap_enabled": os.getenv("LDAP_ENABLED") == "True",
    "ldap_label": os.getenv("LDAP_LABEL", "AD / LDAP"),
    "ldap_url": os.getenv("LDAP_URL", ""),
    "ldap_base_dn": os.getenv("LDAP_BASE_DN", ""),
    "ldap_bind_dn": os.getenv("LDAP_BIND_DN", ""),
    "ldap_bind_password_set": bool(modsecrets.get("LDAP_BIND_PASSWORD")),
    "ldap_user_attribute": os.getenv("LDAP_USER_ATTRIBUTE", "sAMAccountName"),
    "ldap_mail_attribute": os.getenv("LDAP_MAIL_ATTRIBUTE", "mail"),
    "ldap_search_filter": os.getenv("LDAP_SEARCH_FILTER", ""),
    "ldap_validate_cert": os.getenv("LDAP_VALIDATE_CERT") == "true",
    "url": f"https://{host}/" if host else "",
}

json.dump(config, fp=sys.stdout)
