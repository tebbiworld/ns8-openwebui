# Return the current configuration for the UI. The LDAP bind password is never
# echoed back; only a boolean tells the UI whether one is stored. The directory
# settings come from the shared pypkg/ldapsettings.py (ldap_source, ldap_domain,
# ldap_group, ldap_url, ... and the list of the cluster's user domains).

import os
import sys
import json

import agent
import ldapsettings

host = os.getenv("TRAEFIK_HOST", "")

config = {
    "host": host,
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS") == "True",
    "lets_encrypt": agent.get_route(os.environ["MODULE_ID"]).get("lets_encrypt", False),
    "webui_name": os.getenv("WEBUI_NAME", "Open WebUI"),
    "ollama_base_url": os.getenv("OLLAMA_BASE_URL", ""),
    "enable_signup": os.getenv("ENABLE_SIGNUP", "false") == "true",
    "default_user_role": os.getenv("DEFAULT_USER_ROLE", "pending"),
    "enable_openai_api": os.getenv("ENABLE_OPENAI_API", "false") == "true",
    "timezone": os.getenv("TZ", "UTC"),
    # RAG base values (the configured seed; blank/null = Open WebUI's own
    # default is used when the instance is first set up).
    "rag_embedding_engine": os.getenv("RAG_EMBEDDING_ENGINE", ""),
    "rag_embedding_model": os.getenv("RAG_EMBEDDING_MODEL", ""),
    "rag_top_k": int(os.environ["RAG_TOP_K"]) if os.getenv("RAG_TOP_K") else None,
    "rag_chunk_size": int(os.environ["CHUNK_SIZE"]) if os.getenv("CHUNK_SIZE") else None,
    "rag_chunk_overlap": int(os.environ["CHUNK_OVERLAP"]) if os.getenv("CHUNK_OVERLAP") else None,
    "ldap_enabled": os.getenv("LDAP_ENABLED", "false").strip().lower() in ("1", "true"),
    "ldap_label": os.getenv("LDAP_LABEL", "AD / LDAP"),
    "ldap_mail_attribute": os.getenv("LDAP_MAIL_ATTRIBUTE", "mail"),
    "url": f"https://{host}/" if host else "",
}
# Shared directory settings + the cluster's user domains for the selector.
config.update(ldapsettings.configuration())

json.dump(config, fp=sys.stdout)
