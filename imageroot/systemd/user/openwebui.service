# Main unit for the Open WebUI module. It runs a single rootless container: the
# Open WebUI chat interface. Ollama is NOT bundled -- Open WebUI connects to an
# external Ollama instance (OLLAMA_BASE_URL) configured on the settings page.
#
# Networking: the container publishes only 127.0.0.1:${WEB_PORT} -> 8080. Traefik
# terminates TLS on the same node and reverse-proxies to that loopback port
# (HTTP + WebSocket), so nothing is exposed on any external interface.
#
# Runtime settings (including the LDAP/AD bind password and WEBUI_SECRET_KEY)
# live in state/openwebui.env, passed with --env-file. The state volume
# openwebui-data holds the SQLite database, uploads, RAG store and config.

[Unit]
Description=Open WebUI server
After=network-online.target
Wants=network-online.target

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStartSec=300
TimeoutStopSec=70
# openwebui.env (runtime settings) is written by configure-module; touch it so
# the --env-file below never fails on a fresh, not-yet-configured instance.
ExecStartPre=/bin/touch %S/state/openwebui.env
ExecStartPre=/bin/rm -f %t/openwebui.pid %t/openwebui.ctr-id
ExecStart=/usr/bin/podman run \
    --conmon-pidfile %t/openwebui.pid \
    --cidfile %t/openwebui.ctr-id \
    --cgroups=no-conmon \
    --replace -d --name openwebui \
    --publish 127.0.0.1:${WEB_PORT}:8080 \
    --volume openwebui-data:/app/backend/data:z \
    --env-file %S/state/openwebui.env \
    ${OPEN_WEBUI_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/openwebui.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/openwebui.ctr-id
PIDFile=%t/openwebui.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
