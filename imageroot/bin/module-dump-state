#!/usr/bin/env bash

#
# Copyright (C) 2026 tebbi
# SPDX-License-Identifier: GPL-3.0-or-later
#

# Backup hook. Write a CONSISTENT snapshot of the Open WebUI database to
# state/webui.db so the backup does not capture a half-written SQLite file from
# the live volume. The backup framework runs this with the working directory set
# to the module state directory and then includes state/webui.db (see
# etc/state-include.conf); module-cleanup-state removes it afterwards.
#
# Open WebUI keeps its database at /app/backend/data/webui.db inside the
# openwebui-data volume and writes it in WAL mode, so copying the file straight
# from the running volume can tear it. The SQLite online-backup API
# (Connection.backup) produces a transactionally consistent copy while the
# server keeps running; it is taken inside the running container (which has the
# right Python) and copied out.
#
# When the container is not running nothing writes the database, so the copy in
# the volume backup is already consistent and no snapshot is needed.

set -e
exec 1>&2 # stdout is reserved for action output; everything here is a log line

state_dir="${AGENT_STATE_DIR:-${PWD}}"
dump="${state_dir}/webui.db"

# Start from a clean slate: never ship a stale snapshot from an earlier run.
rm -f "${dump}"

if [ "$(podman inspect -f '{{.State.Running}}' openwebui 2>/dev/null)" != "true" ]; then
    echo "module-dump-state: openwebui container is not running; the volume copy of webui.db is quiescent, no snapshot needed"
    exit 0
fi

# Transactionally consistent snapshot, written to a temporary file inside the
# container (not into the volume, which the backup would pick up as well).
podman exec openwebui python3 - <<'PY'
import sqlite3
src = sqlite3.connect("/app/backend/data/webui.db")
dst = sqlite3.connect("/tmp/webui-dump.db")
try:
    with dst:
        src.backup(dst)
finally:
    dst.close()
    src.close()
PY

podman cp openwebui:/tmp/webui-dump.db "${dump}"
podman exec openwebui rm -f /tmp/webui-dump.db
chmod 600 "${dump}"
echo "module-dump-state: wrote a consistent webui.db snapshot ($(stat -c%s "${dump}") bytes)"
