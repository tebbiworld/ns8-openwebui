# ExecStartPre of openwebui.service (through runagent): write state/ldap.env
# with Open WebUI's native LDAP_* settings, resolved fresh on every start (see
# pypkg/owldap.py and pypkg/ldapsettings.py). For a user domain of the cluster
# this reads the node's ldapproxy and its bind account, so a changed bind
# password or a moved domain controller is picked up by a restart (triggered
# by events/user-domain-changed). The file carries the bind password: mode
# 0600, regenerated, and not part of the backup (passwords.env is).
#
# It must never block the start: on any unexpected problem it writes a file that
# turns the directory login off and exits 0, so a transient directory or Redis
# hiccup disables the LDAP login (local admin login still works) instead of
# crash-looping the whole service. A healthy restart re-enables it.

import os
import sys

import owldap

try:
    owldap.write_env_file("ldap.env")
except Exception as exc:
    print(f"discover-ldap: could not resolve the directory, disabling the LDAP login: {exc}", file=sys.stderr)
    os.umask(0o077)
    with open("ldap.env.tmp", "w") as fp:
        fp.write("# discover-ldap failed; LDAP login disabled until the next healthy restart\nENABLE_LDAP=false\n")
    os.replace("ldap.env.tmp", "ldap.env")
