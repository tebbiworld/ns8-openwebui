# The LDAP settings of a user domain changed (e.g. a new bind password or a
# moved domain controller): restart Open WebUI so bin/discover-ldap reads the
# connection again at start. Only relevant when this instance logs in against
# that very domain.

import json
import os
import sys

import agent

event = json.load(sys.stdin)
if (os.environ.get("LDAP_ENABLED", "false").strip().lower() not in ("1", "true")
        or os.environ.get("LDAP_SOURCE", "domain") != "domain"
        or event.get("domain") != os.environ.get("LDAP_DOMAIN")):
    sys.exit(0)
agent.run_helper("systemctl", "--user", "-T", "try-restart", "openwebui.service")
