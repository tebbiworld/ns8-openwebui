# Up to 1.0.2 the secrets were stored with agent.set_env(), i.e. in
# state/environment, which the agent mirrors to Redis in plain text. Move them
# to state/passwords.env (0600); the values do not change.

import os

import modsecrets

modsecrets.migrate_from_env(["WEBUI_SECRET_KEY", "LDAP_BIND_PASSWORD"])

# openwebui.env carries both secrets as well
path = os.path.join(os.environ["AGENT_STATE_DIR"], "openwebui.env")
if os.path.exists(path):
    os.chmod(path, 0o600)
